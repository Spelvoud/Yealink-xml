<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parkeerplaatsen voor Cisco IP Phone 6800/7800/8800 met multiplatform-
  firmware (MPP / 3PCC) en Asterisk res_parking.

  Voeg de elementen toe aan het profiel van het toestel (bv. <mac>.xml of
  spa$PSN.xml). Pas de toetsnummers en het aantal parkeerplaatsen aan; een
  7841 heeft 4 lijntoetsen, een 8851 heeft er 10 (plus eventuele KEM-modules).

    700        parkeren (doorverbinden)
    701 - 710  parkeerplaatsen (bellen = ophalen)
    #72        DTMF-code om tijdens een gesprek te parkeren (features.conf)

  $PROXY vult de telefoon zelf in met de proxy van lijn 1.
-->
<flat-profile>
  <!-- DTMF via RFC 2833 (AVT), nodig voor #72. -->
  <DTMF_Tx_Method_1_ ua="na">AVT</DTMF_Tx_Method_1_>

  <!-- Softkey "Park" tijdens een gesprek: stuurt #72. -->
  <Programmable_Softkey_Enable ua="na">Yes</Programmable_Softkey_Enable>
  <PSK_1 ua="na">fnc=dtmf;ext=#72;nme=Park</PSK_1>
  <Connected_Key_List ua="na">hold|endcall|xfer|conf|bxfer|psk1</Connected_Key_List>

  <!-- Lijntoets 2 t/m 4: BLF per parkeerplaats. Rood = bezet; indrukken = ophalen. -->
  <Extension_2_ ua="na">Disabled</Extension_2_>
  <Short_Name_2_ ua="na">Park 701</Short_Name_2_>
  <Extended_Function_2_ ua="na">fnc=blf+sd;sub=701@$PROXY;ext=701@$PROXY;nme=Park 701</Extended_Function_2_>

  <Extension_3_ ua="na">Disabled</Extension_3_>
  <Short_Name_3_ ua="na">Park 702</Short_Name_3_>
  <Extended_Function_3_ ua="na">fnc=blf+sd;sub=702@$PROXY;ext=702@$PROXY;nme=Park 702</Extended_Function_3_>

  <Extension_4_ ua="na">Disabled</Extension_4_>
  <Short_Name_4_ ua="na">Park 703</Short_Name_4_>
  <Extended_Function_4_ ua="na">fnc=blf+sd;sub=703@$PROXY;ext=703@$PROXY;nme=Park 703</Extended_Function_4_>

  <!-- Meer plaatsen: herhaal met Extension_5_ ... of gebruik een KEM-module. -->
</flat-profile>
